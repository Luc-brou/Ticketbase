@model IEnumerable<Ticketbase.Models.Purchase>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ConcertID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumTicketsOrdered)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerDetails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CardToken)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ConcertID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumTicketsOrdered)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CustomerDetails)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CardToken)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TicketID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TicketID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TicketID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
